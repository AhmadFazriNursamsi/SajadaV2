# Satu port untuk API + web. Mobile memanggil http://<host>:PORT/api
PORT=3000
JWT_SECRET=ganti-dengan-rahasia-panjang
# Kosongkan untuk memakai PGlite (embedded, folder .data/pglite). Isi untuk PostgreSQL:
# DATABASE_URL=postgres://sajadah:sajadah@localhost:5432/sajadah

# Stok opname bulanan: toko dikunci bila opname bulan lalu terlewat. Set off hanya untuk keadaan darurat.
# OPNAME_LOCK=on
