# Salin ke .env di server (berdampingan dengan docker-compose.yml) lalu isi. JANGAN dikomit.

# --- wajib ---
# Rahasia penanda sesi. Buat: openssl rand -base64 48
JWT_SECRET=
# PostgreSQL yang sudah ada. Tambah ?sslmode=require bila server DB mewajibkan SSL.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# Karakter khusus di sandi harus di-URL-encode: @ jadi %40, # jadi %23, / jadi %2F, : jadi %3A, % jadi %25.
# Bila database DBNAME belum ada, dibuat otomatis saat start (user perlu hak CREATEDB). Matikan dengan DB_AUTO_CREATE=false.
# DB_AUTO_CREATE=true

# --- sudah punya nilai bawaan yang benar di image (ubah hanya bila perlu) ---
NODE_ENV=production
PORT=3000
# Di belakang reverse proxy (nginx/Caddy/Traefik) wajib true agar IP asli terbaca untuk pembatas login.
TRUST_PROXY=true
# Jangan pernah true di produksi: true membuat data demo + akun berkata sandi umum bila database kosong.
SEED=false
# Folder unggahan di dalam container (dipetakan ke ./data di server).
PRODUCT_IMAGE_DIR=/data/products
AVATAR_DIR=/data/avatars
VOUCHER_IMAGE_DIR=/data/vouchers

# Web, API, dan aplikasi satu origin (https://sajadah.devoutsys.com): CORS_ORIGIN tidak perlu diisi.
# CORS_ORIGIN=

# --- hanya dipakai skrip pembuat pengurus pertama (docker compose run --rm sajadah node dist/bootstrap-admin.js) ---
BOOTSTRAP_TENANT_NAME=Koperasi Sajadah
BOOTSTRAP_TENANT_SLUG=sajadah
BOOTSTRAP_ADMIN_NAME=Pengurus
BOOTSTRAP_ADMIN_USERNAME=admin
# Kosongkan agar dibuat sandi acak (dicetak sekali). Bila diisi: minimal 8 karakter, huruf + angka.
BOOTSTRAP_ADMIN_PASSWORD=
